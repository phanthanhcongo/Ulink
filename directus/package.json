{
  "name": "ulink-directus-bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Creates ULink collections + roles in a running Directus instance.",
  "scripts": {
    "bootstrap": "node bootstrap.mjs",
    "verify": "node testing/verify_bootstrap.mjs",
    "verify:commercial-import": "node testing/verify_commercial_data_import.mjs",
    "verify:onboarding": "node testing/verify_onboarding.mjs",
    "verify:contact-requests": "node testing/verify_contact_requests.mjs",
    "verify:reset-password": "node testing/verify_password_reset.mjs",
    "verify:change-password": "node testing/verify_password_change.mjs",
    "verify:rfq-notify": "node --import ../frontend/node_modules/tsx/dist/loader.mjs testing/verify_rfq_notification_flow.mjs",
    "verify:newsletter": "node testing/verify_newsletter_subscription.mjs",
    "media:verify": "node testing/verify_media_policy.mjs",
    "media:cleanup": "node scripts/media-cleanup.mjs",
    "rbac:seed": "node seed/rbac_seed.mjs",
    "seed:sample-request": "node seed/sample_request_seed.mjs",
    "rbac:verify": "node testing/rbac_verify.mjs",
    "openapi:export": "node scripts/openapi_export.mjs",
    "ext:build": "node -e \"const fs = require('fs'); const path = require('path'); fs.readdirSync('extensions').forEach(d => { const src = path.join('extensions', d, 'src'); const dist = path.join('extensions', d, 'dist'); if (fs.existsSync(src)) { fs.mkdirSync(dist, { recursive: true }); fs.cpSync(src, dist, { recursive: true }); } })\"",
    "seed:dev": "node -e \"process.env.SEED_DEV_USERS='true'; import('./bootstrap.mjs')\"",
    "bootstrap:railway": "cross-env DOTENV_CONFIG_PATH=../.env.railway node bootstrap.mjs",
    "diagnostic:railway": "cross-env DOTENV_CONFIG_PATH=../.env.railway node diagnostic.mjs"
  },
  "dependencies": {
    "@directus/sdk": "^17.0.1",
    "dotenv": "^16.4.5",
    "ioredis": "^5.11.1",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "argon2": "^0.45.1",
    "cross-env": "^10.1.0"
  }
}
