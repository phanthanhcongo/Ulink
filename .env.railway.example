# ULink B2B Platform — Railway environment
# Copy to .env.railway and fill in real values from Railway dashboard.
# NEVER commit this file with real credentials.

# --- Directus (Railway) ---
DIRECTUS_PUBLIC_URL=https://directus-production-8018.up.railway.app
DIRECTUS_ADMIN_EMAIL=admin@ulink.com
DIRECTUS_ADMIN_PASSWORD=change-me-admin-password

# --- PostgreSQL (Railway internal) ---
# Get this from Railway → your Postgres service → Variables → DATABASE_URL
DB_CONNECTION_STRING=postgresql://user:password@host:port/dbname

# --- Seed dev users (optional) ---
# Set to true only if you want test sales users on Railway staging
SEED_DEV_USERS=false
SEED_DEV_PASSWORD=

# --- Frontend token (optional) ---
DIRECTUS_FRONTEND_TOKEN=
